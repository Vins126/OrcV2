# ═══════════════════════════════════════════════════════════════════════════
#  Copiare in `.env` (non versionato) e compilare.
#
#  Tutti i modelli passano da OpenRouter, con una sola chiave. Il NOME di questa
#  variabile e' dichiarato in models.toml, campo `api_key_env` di
#  `[providers.openrouter]`: qui sta solo il valore.
#
#  Le altre infrastrutture (Anthropic, Moonshot, MiniMax, OpenAI, Tripo, il proxy
#  locale) sono scollegate: vedi docs/INFRASTRUTTURE_SCOLLEGATE.md.
# ═══════════════════════════════════════════════════════════════════════════

ORC2_OPENROUTER_KEY=replace-me


# ── Sviluppo ───────────────────────────────────────────────────────────────
# Facoltativo: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
