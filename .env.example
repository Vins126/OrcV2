# ═══════════════════════════════════════════════════════════════════════════
#  Copiare in `.env` (non versionato) e compilare. Servono solo le variabili
#  del percorso che si intende usare: non e' necessario riempirle tutte.
# ═══════════════════════════════════════════════════════════════════════════

# ── Percorso A — endpoint unico (sviluppo) · `python main.py --via-proxy ...` ──
# Un solo endpoint compatibile OpenAI per tutti i modelli, tipicamente un proxy
# come LiteLLM. Comodo per provare in fretta: una chiave sola, un URL solo.
#
# ⚠️ Non adatto alle misure della campagna sperimentale: passando da un
# aggregatore la prompt cache potrebbe non essere conservata, o non essere
# fatturata con lo sconto del fornitore (ipotesi, da misurare in M2s.4; nei log
# di agosto 2026 la cache compare, ma non c'e' prova dello sconto in fattura).
# Il costo maggiore e' calcolato sul listino, non misurato. Per gli esperimenti
# si usa comunque il percorso B.

ORC2_BASE_URL=http://localhost:4000
ORC2_API_KEY=replace-me

# Deve essere sia un nome che l'endpoint sa servire, sia una chiave di
# models.toml: il primo decide dove va la richiesta, il secondo permette di
# calcolarne il costo.
ORC2_MODEL=minimax-m2-7

# Metadati di audit salvati in ogni UsageRecord: chi viene chiamato
# direttamente e chi fattura. Non sono chiavi di prezzo — il listino lo sceglie
# il modello — ma servono a confrontare i costi fra percorsi diversi.
ORC2_API_PROVIDER=litellm
ORC2_BILLING_PROVIDER=openrouter


# ── Percorso B — chiamata diretta per fornitore (misure) · `python main.py` ──
# Una chiave per fornitore, ognuno raggiunto sul proprio endpoint. E' il
# percorso che dovrebbe conservare gli sconti di cache (da confermare in
# M2s.4), quindi quello su cui i costi misurati sono confrontabili con quelli
# dichiarati dai listini.
#
# I NOMI di queste variabili sono dichiarati in models.toml, campo
# `api_key_env`: qui stanno solo i valori.

ORC2_ANTHROPIC_KEY=replace-me
ORC2_MINIMAX_KEY=replace-me
# ORC2_MOONSHOT_KEY=replace-me
# ORC2_OPENAI_KEY=replace-me
# ORC2_TRIPO_KEY=replace-me


# ── Sviluppo ───────────────────────────────────────────────────────────────
# Facoltativo: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
