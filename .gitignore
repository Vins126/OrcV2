# ───────────────────────────────────────────────────────────────────────────
#  Cosa NON entra nel repository, e perche'
# ───────────────────────────────────────────────────────────────────────────

# Ambiente e dipendenze: si ricostruiscono da requirements.txt
venv/
__pycache__/
*.pyc

# Segreti. Il file .env non e' mai versionato; .env.example ne documenta la
# forma con valori fittizi.
.env

# File che macOS crea da solo in ogni cartella aperta dal Finder (posizione
# delle icone, ordinamento): non fanno parte del progetto.
.DS_Store

# Configurazione locale dell'editor
.idea/
.vscode/

# Cache degli strumenti di sviluppo
.pytest_cache/

# Output di esecuzione. Il workspace e' la sandbox in cui l'agente scrive; i
# ledger delle run sono dati sperimentali che vanno archiviati a parte, non
# mescolati alla storia del codice (vedi README, "Dati prodotti da una run").
workspace/
runs/

# Materiale di studio personale, non parte del lavoro consegnato
docs/STUDIO.md
